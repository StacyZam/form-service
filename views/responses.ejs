<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Ответы: <%= form.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen py-10 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
      <a href="/admin" class="text-sm text-blue-600 hover:underline">← Назад в админку</a>
      <h1 class="text-xl font-bold">Отклики на: <%= form.title %> (<%= submissions.length %>)</h1>
    </div>

    <% if (submissions.length === 0) { %>
      <div class="bg-white p-8 rounded-xl border border-slate-200 text-center text-slate-400">
        Пока нет ни одного отклика.
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% submissions.forEach((sub, idx) => { %>
          <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
            <div class="flex justify-between text-xs text-slate-400 mb-3 border-b pb-2">
              <span>Заявка #<%= idx + 1 %></span>
              <span><%= new Date(sub.submitted_at).toLocaleString() %></span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
              <% Object.entries(sub.answers).forEach(([question, answer]) => { %>
                <div>
                  <span class="block text-xs font-semibold text-slate-500"><%= question %></span>
                  <span class="text-slate-800 whitespace-pre-wrap"><%= answer || '—' %></span>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>